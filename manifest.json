{
  "manifest_version": 3,
  "name": "ElevenLabs Promo Code Checker",
  "version": "1.0.0",
  "description": "Harvests ElevenLabs promo codes and really validates them against ElevenLabs.",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "https://api.stripe.com/*",
    "https://elevenlabs.io/*",
    "https://api.elevenlabs.io/*",
    "https://www.wethrift.com/*",
    "https://elevenlabs.startupworld.com/*",
    "https://devopscube.com/*",
    "https://techjury.net/*",
    "https://grabon.com/*",
    "https://simplycodes.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "ElevenLabs Promo Codes" },
  "content_scripts": [
    {
      "matches": ["https://elevenlabs.io/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://elevenlabs.io/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}